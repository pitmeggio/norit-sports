---
import Base from "../../layouts/Base.astro";
import PageHero from "../PageHero.astro";
import { t, path, type Lang, type RouteKey } from "../../i18n/content";
import { productsByBrand, MAPLUS_LINES, EFB_LINES, type ProductBrand } from "../../data/products";
import { productTitle, productLineTitle, lineLabel, specValue } from "../../data/product-i18n";

// The one fact that decides a purchase in a 323-item wax catalog is the snow
// temperature window, so surface it on the card instead of one click deeper.
const KEY_LABELS = ["Snow temperature", "Air temperature", "Size", "Material"];
function keyFact(p: (typeof products)[number]): string | null {
  for (const label of KEY_LABELS) {
    const hit = p.specs.find((s) => s.labelEn === label);
    if (hit) return specValue(hit, lang);
  }
  return null;
}

interface Props {
  lang: Lang;
  brand: ProductBrand;
}
const { lang, brand } = Astro.props;
const tr = t[lang];

const products = productsByBrand(brand);
const lines = brand === "maplus" ? MAPLUS_LINES : EFB_LINES;
const brandName = brand === "maplus" ? "MAPLUS" : "EFB Sport";
const brandRoute: RouteKey = brand;
const bannerImg = brand === "maplus" ? "/images/maplus/gm-corduroy.jpg" : "/images/efb/polishing-tools.jpg";

const t_label = {
  no: {
    eyebrow: "Produkter",
    title: `${brandName} produkter`,
    intro: `Hele utvalget av ${brandName}-produkter — ${products.length} artikler. Filtrer etter serie, og klikk på et produkt for tekniske detaljer og forespørsel.`,
    filter: "Filter",
    all: "Alle",
    showing: "Viser",
    of: "av",
    products: "produkter",
    askInfo: "Be om info",
    backToBrand: `Tilbake til ${brandName}`,
    search: "Søk i katalogen",
    searchPlaceholder: "Søk etter produkt, serie eller kode",
    noResults: "Ingen produkter passer søket.",
    clear: "Nullstill",
  },
  en: {
    eyebrow: "Products",
    title: `${brandName} products`,
    intro: `The full ${brandName} range — ${products.length} items. Filter by line, click a product for technical details and to request info.`,
    filter: "Filter",
    all: "All",
    showing: "Showing",
    of: "of",
    products: "products",
    askInfo: "Request info",
    backToBrand: `Back to ${brandName}`,
    search: "Search the catalog",
    searchPlaceholder: "Search by product, line or code",
    noResults: "No products match your search.",
    clear: "Clear",
  },
}[lang];

const crumbs = [
  { name: "Norit Sports", url: path(lang, "home") },
  { name: brandName, url: path(lang, brand) },
  { name: lang === "no" ? "Produkter" : "Products", url: `${path(lang, brand)}/${lang === "no" ? "produkter" : "products"}` },
];
---

<Base lang={lang} current={brandRoute} title={t_label.title + " | Norit Sports"} description={t_label.intro} breadcrumbs={crumbs}>
  <PageHero
    eyebrow={t_label.eyebrow}
    title={t_label.title}
    lead={t_label.intro}
    metaLeft={`${products.length} ${t_label.products.toUpperCase()}`}
    metaRight={`${lines.length} ${lang === "no" ? "SERIER" : "LINES"}`}
  />

  <section class="section" style="padding-top:0;">
    <div class="container container--wide">
      <!-- Brand mood banner -->
      <figure class="prod-banner" data-reveal>
        <img src={bannerImg} alt={brandName} loading="eager" />
      </figure>

      <!-- Search -->
      <div class="prod-search">
        <svg class="prod-search__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" id="prod-search" data-prod-search placeholder={t_label.searchPlaceholder} aria-label={t_label.search} autocomplete="off" />
      </div>

      <!-- Filter bar -->
      <div class="prod-filters" data-prod-filters>
        <button class="filter" data-line="all" aria-pressed="true">{t_label.all} <span class="prod-filters__count">({products.length})</span></button>
        {
          lines.map((l) => {
            const cnt = products.filter((p) => p.lineHandle === l.handle).length;
            return (
              <button class="filter" data-line={l.handle} aria-pressed="false">
                {lineLabel(brand, l.handle, l.title, lang)} <span class="prod-filters__count">({cnt})</span>
              </button>
            );
          })
        }
      </div>

      <p class="tech prod-count" data-prod-count style="margin-top:1.4rem;">{t_label.showing} {products.length} {t_label.of} {products.length}</p>

      <!-- Product grid -->
      <div class="prod-grid" id="prod-grid">
        {
          products.map((p, i) => (
            <a
              class="prod-card"
              href={`${path(lang, brand)}/${lang === "no" ? "produkter" : "products"}/${p.slug}`}
              data-line={p.lineHandle}
              data-search={`${productTitle(p, lang)} ${p.title} ${productLineTitle(p, lang)} ${p.tags.join(" ")}`.toLowerCase()}
            >
              <div class="prod-card__media">
                {p.image ? (
                  <img src={p.image} alt={productTitle(p, lang)} loading={i < 12 ? "eager" : "lazy"} />
                ) : (
                  <span class="prod-card__noimg">{brandName}</span>
                )}
              </div>
              <div class="prod-card__body">
                <span class="tech prod-card__line">{productLineTitle(p, lang)}</span>
                <h3 class="prod-card__title">{productTitle(p, lang)}</h3>
                {keyFact(p) && <span class="prod-card__fact">{keyFact(p)}</span>}
              </div>
            </a>
          ))
        }
      </div>

      <p class="prod-empty" data-prod-empty hidden>{t_label.noResults}</p>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ allText: t_label.showing, ofText: t_label.of, productsText: t_label.products }}>
  document.addEventListener("astro:page-load", () => {
    const filters = document.querySelectorAll("[data-prod-filters] .filter");
    const cards = document.querySelectorAll(".prod-card");
    const counter = document.querySelector("[data-prod-count]");
    const search = document.querySelector("[data-prod-search]");
    const empty = document.querySelector("[data-prod-empty]");
    const total = cards.length;
    let currentLine = "all";
    let query = "";

    function render() {
      let active = null;
      filters.forEach((b) => {
        const match = b.dataset.line === currentLine;
        b.setAttribute("aria-pressed", String(match));
        if (match) active = b;
      });
      let visible = 0;
      cards.forEach((c) => {
        const inLine = currentLine === "all" || c.dataset.line === currentLine;
        const inQuery = !query || (c.dataset.search || "").includes(query);
        const show = inLine && inQuery;
        c.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (counter) counter.textContent = `${allText} ${visible} ${ofText} ${total} ${productsText}`;
      if (empty) empty.hidden = visible > 0;
      return active;
    }

    function applyFilter(filterValue) {
      currentLine = filterValue;
      return render();
    }

    if (search) {
      let timer;
      search.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          query = search.value.trim().toLowerCase();
          render();
        }, 120);
      });
    }

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        applyFilter(btn.dataset.line);
        // Update URL (without reload) for shareable filtered link
        const url = new URL(window.location.href);
        if (btn.dataset.line === "all") url.searchParams.delete("line");
        else url.searchParams.set("line", btn.dataset.line);
        history.replaceState(null, "", url);
      });
    });

    // On load: read ?line=xxx from URL and apply
    const params = new URLSearchParams(window.location.search);
    const lineParam = params.get("line");
    if (lineParam) {
      const active = applyFilter(lineParam);
      if (active) {
        active.scrollIntoView({ block: "center", behavior: "auto" });
      }
    }
  });
</script>
