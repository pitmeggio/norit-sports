---
import Base from "../../layouts/Base.astro";
import PageHero from "../PageHero.astro";
import MaplusLinesGrid from "../MaplusLinesGrid.astro";
import { t, path, type Lang } from "../../i18n/content";
import Photo from "../Photo.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t[lang];
const m = tr.maplus;

const crumbs = [
  { name: "Norit Sports", url: path(lang, "home") },
  { name: lang === "no" ? "Merker" : "Brands", url: path(lang, "brands") },
  { name: "MAPLUS", url: path(lang, "maplus") },
];
---

<Base lang={lang} current="maplus" breadcrumbs={crumbs}>
  <PageHero
    eyebrow={m.kicker}
    title="MAPLUS"
    lead={m.intro}
    metaLeft={lang === "no" ? "OFFISIELL NORSK DISTRIBUTØR" : "OFFICIAL NORWEGIAN DISTRIBUTOR"}
    metaRight={lang === "no" ? "SKI · SYKKEL · TEKSTIL" : "SKI · BIKE · TEXTILE"}
  />

  <!-- Quick CTA to full catalog -->
  <section class="section section--tight section--flush-top">
    <div class="container container--wide">
      <a class="btn btn--accent" href={`${path(lang, "maplus")}/${lang === "no" ? "produkter" : "products"}`}>
        {lang === "no" ? "Se hele MAPLUS-katalogen" : "Browse the full MAPLUS catalog"}
        <span style="margin-left:0.5rem; font-size:0.85rem; opacity:0.85;">323 →</span>
      </a>
    </div>
  </section>

  <!-- Brand intro: heading on top, photo beside text (no dead whitespace) -->
  <section class="story section--flush-top">
    <div class="container container--wide">
      <p class="eyebrow" class="section-head__eyebrow" data-reveal>{m.brandKicker}</p>
      <h2 class="display" class="section-head__title" data-reveal>{m.brandTitle}</h2>
      <div class="brand-intro">
        <figure class="brand-intro__media" data-reveal="left">
          <Photo src="/images/maplus/ski-scrape.jpg" alt="MAPLUS race service" sizes="(max-width: 760px) 100vw, 45vw" maxWidth={1600} />
        </figure>
        <div class="brand-intro__text" data-reveal="right" style="--reveal-delay:120ms;">
          <p class="lead">{m.brandBody1}</p>
          <p>{m.brandBody2}</p>
          <dl class="facts" class="section-head__title section-head__title--flush">
            {
              m.facts.map((f) => {
                const num = f.value.match(/^(\d+)(.*)$/);
                return (
                  <div class="fact">
                    {num ? (
                      <dt data-count={num[1]} data-suffix={num[2]}>{f.value}</dt>
                    ) : (
                      <dt>{f.value}</dt>
                    )}
                    <dd>{f.label}</dd>
                  </div>
                );
              })
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Wide showcase of the actual MAPLUS wax range -->
  <section class="section section--flush-top">
    <figure class="showcase" data-reveal>
      <Photo src="/images/maplus/wax-blocks.jpg" alt="MAPLUS racing wax application" sizes="100vw" data-parallax />
      <figcaption>MAPLUS · Race service</figcaption>
    </figure>
  </section>

  <!-- Official MAPLUS product lines (mirrors maplus.it) -->
  <section class="section section--flush-bottom">
    <div class="container container--wide">
      <p class="eyebrow" data-reveal>{m.productsKicker}</p>
      <h2 class="display" class="section-head__title" data-reveal>{lang === "no" ? "Produktserier" : "Product lines"}</h2>
      <MaplusLinesGrid lang={lang} />
    </div>
  </section>

  <!-- Editorial photo strip: race service in action -->
  <section class="section section--flush-bottom">
    <div class="container container--wide">
      <p class="eyebrow" data-reveal>{lang === "no" ? "Race service" : "Race service"}</p>
      <h2 class="display" class="section-head__title" data-reveal>{lang === "no" ? "Fra verkstedet" : "From the workshop"}</h2>
      <div class="photo-strip">
        <figure data-reveal="scale"><Photo src="/images/maplus/powder-pour.jpg" alt="MAPLUS racing powder" sizes="(max-width: 760px) 100vw, 33vw" maxWidth={900} /></figure>
        <figure data-reveal="scale" style="--reveal-delay:80ms;"><Photo src="/images/maplus/factory.jpg" alt="MAFLON factory" sizes="(max-width: 760px) 100vw, 33vw" maxWidth={900} /></figure>
        <figure data-reveal="scale" style="--reveal-delay:160ms;"><Photo src="/images/maplus/iron-drip.jpg" alt="Hot wax application" sizes="(max-width: 760px) 100vw, 33vw" maxWidth={900} /></figure>
      </div>
    </div>
  </section>

  <!-- Athletes: MAPLUS on the World Cup -->
  <section class="section section--flush-bottom">
    <div class="container container--wide">
      <p class="eyebrow" data-reveal>{lang === "no" ? "Utøvere" : "Athletes"}</p>
      <h2 class="display" class="section-head__title section-head__title--flush" data-reveal>{lang === "no" ? "MAPLUS i verdenscupen" : "MAPLUS on the World Cup"}</h2>
      <p class="lead" class="section-head__lead" data-reveal>{lang === "no" ? "Produktene utvikles og testes sammen med utøvere på øverste internasjonale nivå." : "The products are developed and tested with athletes at the highest international level."}</p>
      <div class="athlete athlete--wide" data-reveal>
        <Photo src="/images/maplus/hero-pellegrino.jpg" alt="Federico Pellegrino" sizes="100vw" data-parallax />
        <div class="athlete__body">
          <div class="athlete__name">Federico Pellegrino</div>
          <div class="athlete__meta">{lang === "no" ? "Langrenn · Verdensmester i sprint" : "Cross-country · World sprint champion"}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Videos CTA on dark band -->
  <section class="pros">
    <div class="container container--wide">
      <p class="eyebrow eyebrow--light" data-reveal>{m.videosTitle}</p>
      <div class="pros__head" style="margin-top:1.6rem;">
        <h2 class="pros__title" data-reveal>{m.videosTitle}</h2>
        <div class="pros__intro" data-reveal style="--reveal-delay:120ms;">
          <p>{m.videosDesc}</p>
          <a class="btn btn--light" style="margin-top:1.5rem;" href={path(lang, "videos")}>{m.videosButton}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
