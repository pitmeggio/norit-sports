---
// Single entry point for every photo on the site.
//
// Local photos go through Astro's image pipeline: WebP, a responsive srcset and
// intrinsic width/height. Remote sources (the product shots still served from
// MAPLUS's Shopify CDN) fall through to a plain <img> untouched.
//
// It emits a bare <img>, not a <picture>, so the DOM stays exactly as the
// existing CSS expects — several image containers are flex parents.
import { Image } from "astro:assets";
import { localImage, widthsFor } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  /** Layout width hint for the browser. Defaults to full viewport. */
  sizes?: string;
  /** Cap the largest generated width when the photo is never shown full-bleed. */
  maxWidth?: number;
  loading?: "lazy" | "eager";
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  sizes = "100vw",
  maxWidth,
  loading = "lazy",
  class: className,
  ...rest
} = Astro.props;

const asset = localImage(src);

// Astro's Image drops alt="" entirely, which is worse than declaring the image
// decorative: assistive tech falls back to announcing the file name. Marking
// the role keeps those images correctly ignored.
const decorative = alt === "";
---

{
  asset ? (
    <Image
      src={asset}
      alt={alt}
      widths={widthsFor(asset, maxWidth)}
      sizes={sizes}
      format="webp"
      quality={72}
      loading={loading}
      decoding="async"
      class={className}
      role={decorative ? "presentation" : undefined}
      {...rest}
    />
  ) : (
    <img src={src} alt={alt} loading={loading} decoding="async" class={className} {...rest} />
  )
}
